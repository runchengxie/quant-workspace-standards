[
  {
    "id": "audit-readonly",
    "request": "只审计这个项目的计价逻辑，报告有证据的问题和实际验证结果，不要修改任何文件。",
    "expected_use": true,
    "invariants": [
      "all_files_preserved",
      "quantity_bug_reported",
      "no_delivery_claim"
    ]
  },
  {
    "id": "routine-edit",
    "request": "把 README.md 的标题从 Greeting example 改成 Greeting demo，其他内容保持不变。",
    "expected_use": false,
    "invariants": [
      "only_requested_title_changed"
    ]
  },
  {
    "id": "docs-sync",
    "request": "检查并修正文档与实际 CLI 默认值不一致的地方，验证示例，保留其他人的未提交修改。",
    "expected_use": true,
    "invariants": [
      "readme_default_is_2",
      "scratch_preserved",
      "runtime_unchanged"
    ]
  },
  {
    "id": "closeout",
    "request": "收尾这次修改：检查已合并变更与剩余 worktree，清理有证据且属于本任务的残留，报告交付状态。",
    "expected_use": true,
    "invariants": [
      "locked_dirty_worktree_preserved",
      "task_branch_preserved_when_PR_state_unknown",
      "merge_not_confused_with_release"
    ]
  },
  {
    "id": "consumer-adoption",
    "request": "只读核对 provider 和 consumer 的交付与采用状态，说明是否已经兼容，不要修改仓库或依赖版本。",
    "expected_use": true,
    "invariants": [
      "provider_v2_consumer_v1_gap_reported",
      "no_unverified_remote_merge_claim",
      "all_files_preserved"
    ]
  },
  {
    "id": "no-change",
    "request": "以 full 模式检查维护这个项目，只有存在有证据的问题才修改，报告实际检查和剩余工作。",
    "expected_use": true,
    "invariants": [
      "no_manufactured_changes",
      "checks_actually_run",
      "no_delivery_claim"
    ]
  }
]
