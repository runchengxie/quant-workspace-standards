{
  "name": "quant-workspace-standards-site",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.3",
  "engines": {
    "node": ">=22.12.0",
    "bun": "1.4.3"
  },
  "scripts": {
    "dev": "astro dev",
    "check": "astro check && tsc --noEmit",
