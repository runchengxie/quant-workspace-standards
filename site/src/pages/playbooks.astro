---
import Layout from '../layouts/Layout.astro';
import Document from '../components/Document.astro';
import Prompts from '../components/Prompts.astro';
import catalog from '../../locales.json';
const text = catalog['en-US'];
---
<Layout page="playbooks" route="playbooks/index.html" bodyClass="playbooks">
  <header class="page-intro">
    <h1 data-i18n="playbooksTitle">{text.playbooksTitle}</h1>
    <p data-i18n="playbooksIntro">{text.playbooksIntro}</p>
  </header>
  <div class="playbook-columns">
    <section class="prompt-version" aria-labelledby="prompt-version-title">
      <header class="version-heading"><h2 id="prompt-version-title" data-i18n="promptVersion">{text.promptVersion}</h2></header>
      <Prompts />
    </section>
    <aside class="skill-version" aria-labelledby="skill-version-title">
      <span class="version-or" aria-hidden="true" data-i18n="versionOr">{text.versionOr}</span>
      <header class="version-heading"><h2 id="skill-version-title" data-i18n="skillVersion">{text.skillVersion}</h2></header>
      <Document name="playbooks" />
    </aside>
  </div>
  <details class="maintenance-example">
    <summary data-i18n="maintenanceExample">{text.maintenanceExample}</summary>
    <Document name="maintenance-example" />
  </details>
</Layout>
