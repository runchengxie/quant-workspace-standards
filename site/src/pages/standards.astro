---
import Layout from '../layouts/Layout.astro';
import StandardsDocument from '../components/StandardsDocument.astro';
import catalog from '../../locales.json';
import WorktreeFlow from '../components/WorktreeFlow.astro';
---
<Layout page="standards" route="standards/index.html" bodyClass="standards">
  <div class="standards-toolbar">
  <div><h1 class="standards-heading" data-i18n="standards">{catalog['en-US'].standards}</h1><p class="notice" data-i18n="standardsPurpose">{catalog['en-US'].standardsPurpose}</p></div>
  <div class="resources" aria-label={catalog['en-US'].standardsDownloads} data-i18n-aria="standardsDownloads">
    <a class="download-option primary-download" href="../downloads/AGENTS.md" download="AGENTS.md"><strong data-i18n="downloadEnglish">{catalog['en-US'].downloadEnglish}</strong><code>AGENTS.md</code><span data-i18n="downloadEnglishDetail">{catalog['en-US'].downloadEnglishDetail}</span><b data-i18n="downloadAction">{catalog['en-US'].downloadAction}</b></a>
    <a class="download-option" href="../downloads/AGENTS.zh-CN.md" download="AGENTS.zh-CN.md"><strong data-i18n="downloadChinese">{catalog['en-US'].downloadChinese}</strong><code>AGENTS.zh-CN.md</code><span data-i18n="downloadChineseDetail">{catalog['en-US'].downloadChineseDetail}</span><b data-i18n="downloadAction">{catalog['en-US'].downloadAction}</b></a>
  </div>
  <p id="standards-relation" class="standards-relation sr-only" data-i18n="standardsRelation">{catalog['en-US'].standardsRelation}</p>
  </div>
  <WorktreeFlow><StandardsDocument /></WorktreeFlow>
</Layout>
