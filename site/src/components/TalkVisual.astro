---
import catalog from '../../locales.json';
interface Props { id: string }
const { id } = Astro.props;
const text = catalog['en-US'];
const descriptions = {questions:'talkQuestionsVisual',customers:'talkCustomersVisual',ownership:'talkOwnershipVisual',workflows:'talkWorkflowVisual'} as const;
const description = descriptions[id as keyof typeof descriptions];
---
<figure class:list={['talk-visual', `talk-visual-${id}`]} data-talk-story={id}>
  <figcaption class="sr-only" data-i18n={description}>{text[description]}</figcaption>
  {id === 'questions' && <div class="quiet-scene quiet-directions">
    <svg viewBox="0 0 800 240" aria-hidden="true"><g class="quiet-loop"><path d="M280 120 A80 80 0 1 1 256 63"/><path d="M238 66 L258 61 L254 82"/></g><g class="quiet-turn" data-quiet-motion="direction"><path d="M280 120 H420 Q450 120 470 98 L550 30 H685"/><path d="M672 20 L686 30 L672 40"/></g></svg>
    <span class="quiet-loop-label" data-i18n="quietTune">{text.quietTune}</span><span class="quiet-turn-label" data-i18n="quietQuestion">{text.quietQuestion}</span>
  </div>}
  {id === 'customers' && <div class="quiet-scene quiet-comparison">
    <div class="quiet-object"><div class="quiet-paper quiet-back" data-quiet-motion="back"></div><div class="quiet-paper quiet-back2" data-quiet-motion="back2"></div><div class="quiet-paper quiet-front" data-quiet-motion="report">{Array.from({length:5},()=> <i/> )}</div><span class="quiet-label" data-i18n="quietInformation">{text.quietInformation}</span></div>
    <span class="quiet-arrow" aria-hidden="true">→</span>
    <div class="quiet-object"><div class="quiet-paper quiet-list" data-quiet-motion="list">{Array.from({length:3},()=> <i/> )}</div><span class="quiet-label" data-i18n="quietResult">{text.quietResult}</span><span class="sr-only" data-i18n="talkStockList">{text.talkStockList}</span></div>
  </div>}
  {id === 'ownership' && <div class="quiet-scene quiet-time">
    <div class="quiet-time-axis"><span class="quiet-time-early">07:00</span><span class="quiet-time-original">09:00</span><span class="quiet-time-open">09:30</span><div class="quiet-buffer" data-quiet-motion="buffer"></div><span class="quiet-buffer-label" data-i18n="quietBuffer">{text.quietBuffer}</span><div class="quiet-delivery" data-quiet-motion="delivery"><i/><span data-i18n="quietDelivery">{text.quietDelivery}</span></div></div>
  </div>}
  {id === 'workflows' && <div class="quiet-resources">
    <a href="../../standards/index.html"><span data-i18n="quietStandards">{text.quietStandards}</span><span aria-hidden="true">↗</span></a>
    <a href="../../playbooks/index.html"><span data-i18n="quietPrompts">{text.quietPrompts}</span><span aria-hidden="true">↗</span></a>
    <a href="../../downloads/repo-maintenance.zip"><span>Skill</span><svg width="16" height="20" viewBox="0 0 16 20" aria-hidden="true"><path d="M8 2v14m-5-5 5 5 5-5" fill="none" stroke="currentColor"/></svg></a>
  </div>}
  {id !== 'workflows' && <div class="talk-story-controls" hidden>
    <button type="button" data-story-toggle data-i18n="storyPause" aria-pressed="false">{text.storyPause}</button>
  </div>}
</figure>
