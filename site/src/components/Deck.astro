---
import { locales, slides } from '../lib/content';
import { siteUrl } from '../lib/paths';
import QRCode from 'qrcode';
import catalog from '../../locales.json';
import TalkVisual from './TalkVisual.astro';
const svg = await QRCode.toString(`${siteUrl}playbooks/`, { type: 'svg', errorCorrectionLevel: 'M', margin: 4 });
---
{slides.map((slide, index) => <section class:list={["slide", { "slide-illustrated": slide.image }]} id={slide.id} data-notes={slide.notes} hidden={index !== 0}>
  <p class="talk-duration" data-i18n="talkDuration">{catalog["en-US"].talkDuration}</p>
  <div class="slide-number">{String(index + 1).padStart(2, '0')} / {String(slides.length).padStart(2, '0')}</div>
  <div class="slide-content">
  {locales.map(locale => <div data-locale={locale} hidden={locale !== 'en-US'}><h1>{slide.title[locale]}</h1><ul>{slide.points[locale].map(point => <li>{point}</li>)}</ul></div>)}
  <div class="talk-evidence">
    <TalkVisual id={slide.id} />
    {index === slides.length - 1 && <details class="talk-image-disclosure talk-qr-disclosure"><summary data-i18n="imageDisclosure">{catalog['en-US'].imageDisclosure}</summary><div class="resources"><div class="qr" role="img" aria-label={catalog['en-US'].qr} data-i18n-aria="qr" set:html={svg}></div><a href="../../playbooks/index.html" data-i18n="resources">{catalog['en-US'].resources}</a></div></details>}
  </div>
  {slide.image && <details class="talk-image-disclosure"><summary data-i18n="imageDisclosure">{catalog['en-US'].imageDisclosure}</summary><figure class="talk-illustration">{locales.map(locale => <img data-locale={locale} hidden={locale !== "en-US"} src={"../../assets/talk/2026-10-18/" + slide.image!.src} alt={slide.image!.alt[locale]} />)}<figcaption><a href={"../../assets/talk/2026-10-18/" + slide.image.src} target="_blank" rel="noopener" data-i18n="imageFullSize">{catalog['en-US'].imageFullSize}</a><span data-i18n="imageCredit">{catalog["en-US"].imageCredit}</span><a href={slide.image.source} data-i18n="imageSource">{catalog["en-US"].imageSource}</a></figcaption></figure></details>}
  </div>
</section>)}
<div class="progress"><span id="progress-bar"></span></div>
<div class="deck-controls">
  <button id="previous" data-i18n="previous">{catalog['en-US'].previous}</button><span id="page-count" role="status" aria-live="polite"></span><button id="next" data-i18n="next">{catalog['en-US'].next}</button>
  <button id="fullscreen" data-i18n="fullscreen">{catalog['en-US'].fullscreen}</button><button id="notes-toggle" data-i18n="notes" aria-expanded="false" aria-controls="speaker-notes">{catalog['en-US'].notes}</button>
</div>
<p class="help" data-i18n="keyboard">{catalog['en-US'].keyboard}</p><p id="deck-status" role="status"></p>
<aside class="speaker-notes document" id="speaker-notes" hidden lang="zh-CN"><p id="notes-text"></p></aside>
<a class="reading-link" href="reading.html" data-i18n="reading">{catalog['en-US'].reading}</a>
<a href={`${siteUrl}downloads/engineering-practices-offline.zip`} data-i18n="offline">{catalog['en-US'].offline}</a>
